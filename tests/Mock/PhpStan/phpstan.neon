services:
    -
        class: Fyre\TestSuite\PhpStan\Extensions\ModelFunctionReturnTypeExtension
        arguments:
            modelNamespaces:
                - Tests\Mock\Models\ORM
            modelNamespacesOverrides:
                -
                    classes:
                        - Tests\Mock\PhpStan\ModelFunctionOverride
                    modelNamespaces:
                        - Tests\Mock\Models
        tags:
            - phpstan.broker.dynamicFunctionReturnTypeExtension
    -
        class: Fyre\TestSuite\PhpStan\Extensions\ModelRegistryUseReturnTypeExtension
        arguments:
            modelNamespaces:
                - Tests\Mock\Models\ORM
            modelNamespacesOverrides:
                -
                    classes:
                        - Tests\Mock\PhpStan\ModelRegistryOverride
                    modelNamespaces:
                        - Tests\Mock\Models
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension
    -
        class: Fyre\TestSuite\PhpStan\Extensions\TypeFunctionReturnTypeExtension
        arguments:
            typeMap:
                money: Fyre\DB\Types\DecimalType
                double: Fyre\DB\Types\FloatType
                int: Fyre\DB\Types\DecimalType
        tags:
            - phpstan.broker.dynamicFunctionReturnTypeExtension
    -
        class: Fyre\TestSuite\PhpStan\Extensions\TypeParserUseReturnTypeExtension
        arguments:
            typeMap:
                money: Fyre\DB\Types\DecimalType
                double: Fyre\DB\Types\FloatType
                int: Fyre\DB\Types\DecimalType
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension
